{
    "apiVersion": 1,
    "groups": [
        {
            "orgId": 1,
            "name": "Ogmios",
            "folder": "Demeter",
            "interval": "1m",
            "rules": [
                {
                    "uid": "bkl0ogtipstale",
                    "title": "Ogmios is behind Cardano node",
                    "condition": "C",
                    "data": [
                        {
                            "refId": "A",
                            "relativeTimeRange": {
                                "from": 900,
                                "to": 0
                            },
                            "datasourceUid": "${datasource_uid_map.gke_blinklabs-demeter_us-central1_dmtr-cluster-prometheus}",
                            "model": {
                                "datasource": {
                                    "type": "prometheus",
                                    "uid": "${datasource_uid_map.gke_blinklabs-demeter_us-central1_dmtr-cluster-prometheus}"
                                },
                                "editorMode": "code",
                                "expr": "max by (network) (cardano_node_metrics_slotNum_int{namespace=\"ext-nodes-m1\", network=~\"mainnet|preprod|preview\"}) - on (network) group_right() max by (network, pod, ogmios_version) (label_replace(ogmios_tip_slot{namespace=\"ext-ogmios-m1\", pod=~\".*(mainnet|preprod|preview).*\"}, \"network\", \"$1\", \"pod\", \".*(mainnet|preprod|preview).*\"))",
                                "instant": true,
                                "intervalMs": 1000,
                                "legendFormat": "__auto",
                                "maxDataPoints": 43200,
                                "range": false,
                                "refId": "A"
                            }
                        },
                        {
                            "refId": "B",
                            "relativeTimeRange": {
                                "from": 0,
                                "to": 0
                            },
                            "datasourceUid": "__expr__",
                            "model": {
                                "conditions": [
                                    {
                                        "evaluator": {
                                            "params": [
                                                0,
                                                0
                                            ],
                                            "type": "gt"
                                        },
                                        "operator": {
                                            "type": "and"
                                        },
                                        "query": {
                                            "params": []
                                        },
                                        "reducer": {
                                            "params": [],
                                            "type": "last"
                                        },
                                        "type": "query"
                                    }
                                ],
                                "datasource": {
                                    "name": "Expression",
                                    "type": "__expr__",
                                    "uid": "__expr__"
                                },
                                "expression": "A",
                                "hide": false,
                                "reducer": "last",
                                "refId": "B",
                                "type": "reduce"
                            }
                        },
                        {
                            "refId": "C",
                            "relativeTimeRange": {
                                "from": 0,
                                "to": 0
                            },
                            "datasourceUid": "__expr__",
                            "model": {
                                "conditions": [
                                    {
                                        "evaluator": {
                                            "params": [
                                                120,
                                                0
                                            ],
                                            "type": "gt"
                                        },
                                        "operator": {
                                            "type": "and"
                                        },
                                        "query": {
                                            "params": []
                                        },
                                        "reducer": {
                                            "params": [],
                                            "type": "avg"
                                        },
                                        "type": "query"
                                    }
                                ],
                                "datasource": {
                                    "name": "Expression",
                                    "type": "__expr__",
                                    "uid": "__expr__"
                                },
                                "expression": "B",
                                "hide": false,
                                "refId": "C",
                                "type": "threshold"
                            }
                        }
                    ],
                    "noDataState": "OK",
                    "execErrState": "KeepLast",
                    "annotations": {
                        "description": "The Ogmios tip is more than 120 Cardano slots (about 2 minutes) behind the freshest Cardano node tip on the same network. Restart the identified Ogmios pod after checking its logs.",
                        "summary": "Ogmios pod {{ $labels.pod }} on {{ $labels.network }} is over 2 minutes behind the Cardano node tip"
                    },
                    "labels": {},
                    "isPaused": false,
                    "notification_settings": {
                        "receiver": "#infra-alerts"
                    }
                }
            ]
        }
    ]
}
