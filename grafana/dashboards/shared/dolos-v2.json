{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "What a Dolos v2 cell is serving and how well, per network and per cell, from its OTLP series.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Tip",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Slot of the newest archived block, per cell. A cell with an empty archive reports none.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "max by (instance) (dolos_sync_tip_slot{instance=~\"$cell\"} and on (job, instance) target_info{dolos_network=~\"$network\"})",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Tip slot",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Wall clock minus the time of the newest archived block's slot, per cell.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "max by (instance) (dolos_sync_tip_lag_seconds{instance=~\"$cell\"} and on (job, instance) target_info{dolos_network=~\"$network\"})",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Tip lag",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Time since the upstream peer last delivered blocks or reached its tip. Not reported before the first delivery.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "max by (instance) (dolos_sync_upstream_last_delivery_age_seconds{instance=~\"$cell\"} and on (job, instance) target_info{dolos_network=~\"$network\"})",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Upstream delivery age",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "1 once the stores committed the upstream tip since the process started, else 0.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "syncing",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "caught up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "max by (instance) (dolos_sync_caught_up{instance=~\"$cell\"} and on (job, instance) target_info{dolos_network=~\"$network\"})",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Caught up",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "The build each cell runs, from dolos_build_info.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 9
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "max by (instance, version, git_sha) (dolos_build_info{instance=~\"$cell\"} and on (job, instance) target_info{dolos_network=~\"$network\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "title": "Builds",
      "type": "table",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "instance": 0,
              "version": 1,
              "git_sha": 2
            },
            "renameByName": {
              "instance": "cell"
            }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 7,
      "panels": [],
      "title": "Serving",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Requests answered per second, by cell and surface (minibf, minikupo, grpc, trp).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum by (instance, surface) (rate({__name__=~\"http_server_request_duration_seconds_count|rpc_server_call_duration_seconds_count\", instance=~\"$cell\"}[$__rate_interval]) and on (job, instance) target_info{dolos_network=~\"$network\"})",
          "legendFormat": "{{instance}} {{surface}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Requests per second",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "2m"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Share of requests that ended in a server-side fault: HTTP 5xx (limiter rejections and deadline cuts included), gRPC UNKNOWN, DEADLINE_EXCEEDED, RESOURCE_EXHAUSTED, INTERNAL, UNAVAILABLE or DATA_LOSS (a server stream by its final status), and TRP internal errors.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 9,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "(sum by (instance, surface) ((rate(http_server_request_duration_seconds_count{instance=~\"$cell\", http_response_status_code=~\"5..\"}[$__rate_interval]) or (rate(rpc_server_call_duration_seconds_count{instance=~\"$cell\", rpc_response_status_code=~\"UNKNOWN|DEADLINE_EXCEEDED|RESOURCE_EXHAUSTED|INTERNAL|UNAVAILABLE|DATA_LOSS|-32603\"}[$__rate_interval]) unless on (job, instance, rpc_service, rpc_method) dolos_rpc_server_streams_ended_total{instance=~\"$cell\"}) or rate(dolos_rpc_server_streams_ended_total{instance=~\"$cell\", rpc_response_status_code=~\"UNKNOWN|DEADLINE_EXCEEDED|RESOURCE_EXHAUSTED|INTERNAL|UNAVAILABLE|DATA_LOSS\"}[$__rate_interval])) and on (job, instance) target_info{dolos_network=~\"$network\"}) or 0 * sum by (instance, surface) (rate({__name__=~\"http_server_request_duration_seconds_count|rpc_server_call_duration_seconds_count\", instance=~\"$cell\"}[$__rate_interval]) and on (job, instance) target_info{dolos_network=~\"$network\"})) / (sum by (instance, surface) (rate({__name__=~\"http_server_request_duration_seconds_count|rpc_server_call_duration_seconds_count\", instance=~\"$cell\"}[$__rate_interval]) and on (job, instance) target_info{dolos_network=~\"$network\"}) > 0)",
          "legendFormat": "{{instance}} {{surface}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Error share",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "2m"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "p50 of request duration, by cell and surface. HTTP runs to the response head; a gRPC stream to its first message.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 10,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, instance, surface) (rate({__name__=~\"http_server_request_duration_seconds_bucket|rpc_server_call_duration_seconds_bucket\", instance=~\"$cell\"}[$__rate_interval]) and on (job, instance) target_info{dolos_network=~\"$network\"}))",
          "legendFormat": "{{instance}} {{surface}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Latency p50",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "2m"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "p95 of request duration, by cell and surface. HTTP runs to the response head; a gRPC stream to its first message.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "id": 11,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, instance, surface) (rate({__name__=~\"http_server_request_duration_seconds_bucket|rpc_server_call_duration_seconds_bucket\", instance=~\"$cell\"}[$__rate_interval]) and on (job, instance) target_info{dolos_network=~\"$network\"}))",
          "legendFormat": "{{instance}} {{surface}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Latency p95",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "2m"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "p99 of request duration, by cell and surface. HTTP runs to the response head; a gRPC stream to its first message.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "id": 12,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, instance, surface) (rate({__name__=~\"http_server_request_duration_seconds_bucket|rpc_server_call_duration_seconds_bucket\", instance=~\"$cell\"}[$__rate_interval]) and on (job, instance) target_info{dolos_network=~\"$network\"}))",
          "legendFormat": "{{instance}} {{surface}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Latency p99",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "2m"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "p95 duration over the dashboard's time range, by HTTP route or RPC method, across the selected cells.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 13,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "topk(10, max by (surface, route) (label_replace(histogram_quantile(0.95, sum by (le, surface, http_route) (rate(http_server_request_duration_seconds_bucket{instance=~\"$cell\"}[$__range]) and on (job, instance) target_info{dolos_network=~\"$network\"})) > 0, \"route\", \"$1\", \"http_route\", \"(.*)\")) or max by (surface, route) (label_replace(histogram_quantile(0.95, sum by (le, surface, rpc_method) (rate(rpc_server_call_duration_seconds_bucket{instance=~\"$cell\"}[$__range]) and on (job, instance) target_info{dolos_network=~\"$network\"})) > 0, \"route\", \"$1\", \"rpc_method\", \"(.*)\")))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "title": "Ten slowest routes",
      "type": "table",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "surface": 0,
              "route": 1,
              "Value": 2
            },
            "renameByName": {
              "Value": "p95"
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Requests being answered now, by cell and surface. A gRPC server stream counts until its first message.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 14,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum by (instance, surface) ({__name__=~\"http_server_active_requests|dolos_rpc_server_active_requests\", instance=~\"$cell\"} and on (job, instance) target_info{dolos_network=~\"$network\"})",
          "legendFormat": "{{instance}} {{surface}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "In-flight requests",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Requests whose client went away before the answer, per second, by cell and surface.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "id": 15,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum by (instance, surface) (rate({__name__=~\"dolos_http_server_request_dropped_total|dolos_rpc_server_request_dropped_total\", instance=~\"$cell\"}[$__rate_interval]) and on (job, instance) target_info{dolos_network=~\"$network\"})",
          "legendFormat": "{{instance}} {{surface}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Dropped requests",
      "type": "timeseries",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "2m"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "id": 16,
      "panels": [],
      "title": "Query limiter",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Permits in use over capacity, for all blocking queries and for heavy-scan slots, per cell.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
